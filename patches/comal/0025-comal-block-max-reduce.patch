diff --git a/tests/block_max_reduce.rs b/tests/block_max_reduce.rs
new file mode 100644
index 0000000..66a64d0
--- /dev/null
+++ b/tests/block_max_reduce.rs
@@ -0,0 +1,42 @@
+// 0025: true-block max reduction = per-row max over all blocks of a fiber, broadcast over the block's columns.
+use comal::templates::accumulator::{BlockMaxReduce, MaxReduceData};
+use comal::templates::primitive::Token;
+use comal::templates::tensor::Tensor;
+use dam::simulation::*;
+use dam::utility_contexts::{CheckerContext, GeneratorContext};
+use ndarray::{Array2, Ix2};
+
+type VT16 = Tensor<'static, f32, Ix2, 16>;
+
+fn rowmax(m: &Array2<f32>) -> Array2<f32> {
+    let v: Vec<f32> = m.rows().into_iter().map(|row| row.iter().cloned().fold(f32::NEG_INFINITY, f32::max)).collect();
+    Array2::from_shape_fn((16, 16), |(r, _)| v[r])
+}
+
+#[test]
+fn row_max_over_blocks() {
+    let a = Array2::from_shape_fn((16, 16), |(r, c)| (r as f32) * 3.0 - (c as f32) * 0.5 + 100.0); // positive
+    let b = Array2::from_shape_fn((16, 16), |(r, c)| if c == 5 { 1000.0 + r as f32 } else { -7.0 });
+    let neg = Array2::from_shape_fn((16, 16), |(r, c)| -1.0 - (r * 16 + c) as f32); // all < 0
+    let ab = Array2::from_shape_fn((16, 16), |(r, c)| a[[r, c]].max(b[[r, c]]));
+    let (va, vb, vn) = (VT16::new(a.clone()), VT16::new(b.clone()), VT16::new(neg.clone()));
+    let expect = vec![
+        Token::<VT16, u32>::Val(VT16::new(rowmax(&ab))), // fiber 1: blocks a and b
+        Token::Val(VT16::new(rowmax(&neg))),             // fiber 2: one all-negative block (not clipped at 0)
+        Token::Stop(0),
+        Token::Done,
+    ];
+    let mut ctx = ProgramBuilder::default();
+    let (snd, rcv) = ctx.unbounded::<Token<VT16, u32>>();
+    let (osnd, orcv) = ctx.unbounded::<Token<VT16, u32>>();
+    ctx.add_child(GeneratorContext::new(
+        move || {
+            vec![Token::Val(va.clone()), Token::Val(vb.clone()), Token::Stop(0), Token::Val(vn.clone()), Token::Stop(1), Token::Done]
+                .into_iter()
+        },
+        snd,
+    ));
+    ctx.add_child(BlockMaxReduce::<u32, 16>::new(MaxReduceData { in_val: rcv, out_val: osnd }));
+    ctx.add_child(CheckerContext::new(move || expect.clone().into_iter(), orcv));
+    ctx.initialize(Default::default()).unwrap().run(Default::default());
+}
