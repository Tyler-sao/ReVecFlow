+// 0025: max reduction in true-block mode. MaxReduce compares whole blocks with PartialOrd (lexicographic over the raw
+// values) and keeps one whole block, starting from an all-zero block - not a row max: for a row of positive values it
+// returns the row itself, so a softmax's x - max(x) became 0. BlockMaxReduce keeps the element-wise max over the
+// blocks of a fiber (starting from -inf), and at the fiber's stop takes the max along each row of that block,
+// broadcast over the block's columns - the max counterpart of the block sum reduction (Addsum, FinalReduce::sum_axis).
+// Timing as MaxReduce (one cycle per token, output one cycle after the stop): values fixed, Comal's timing unchanged.
+#[context_macro]
+pub struct BlockMaxReduce<StopType: Clone, const N: usize> {
+    max_reduce_data: MaxReduceData<super::tensor::Tensor<'static, f32, ndarray::Ix2, N>, StopType>,
+}
+
+impl<StopType: DAMType, const N: usize> BlockMaxReduce<StopType, N>
+where
+    BlockMaxReduce<StopType, N>: Context,
+{
+    pub fn new(max_reduce_data: MaxReduceData<super::tensor::Tensor<'static, f32, ndarray::Ix2, N>, StopType>) -> Self {
+        let red = BlockMaxReduce { max_reduce_data, context_info: Default::default() };
+        (red.max_reduce_data.in_val).attach_receiver(&red);
+        (red.max_reduce_data.out_val).attach_sender(&red);
+        red
+    }
+}
+
+impl<StopType, const N: usize> Context for BlockMaxReduce<StopType, N>
+where
+    super::tensor::Tensor<'static, f32, ndarray::Ix2, N>: DAMType,
+    StopType: DAMType + std::ops::Sub<u32, Output = StopType> + std::cmp::PartialEq,
+{
+    fn init(&mut self) {}
+
+    fn run(&mut self) {
+        let neg = || ndarray::Array2::<f32>::from_elem((N, N), f32::NEG_INFINITY);
+        let mut acc = neg();
+        loop {
+            match self.max_reduce_data.in_val.dequeue(&self.time) {
+                Ok(curr_in) => match curr_in.data {
+                    Token::Val(val) => {
+                        acc.zip_mut_with(&val.data, |a, b| {
+                            if *b > *a {
+                                *a = *b
+                            }
+                        });
+                    }
+                    Token::Stop(stkn) => {
+                        let curr_time = self.time.tick();
+                        let rows = acc.fold_axis(ndarray::Axis(1), f32::NEG_INFINITY, |m, x| m.max(*x));
+                        let out = rows.insert_axis(ndarray::Axis(1)).broadcast((N, N)).unwrap().to_owned();
+                        self.max_reduce_data
+                            .out_val
+                            .enqueue(
+                                &self.time,
+                                ChannelElement::new(curr_time + 1, Token::Val(super::tensor::Tensor::new(out))),
+                            )
+                            .unwrap();
+                        acc = neg();
+                        if stkn != StopType::default() {
+                            self.max_reduce_data
+                                .out_val
+                                .enqueue(&self.time, ChannelElement::new(curr_time + 1, Token::Stop(stkn - 1)))
+                                .unwrap();
+                        }
+                    }
+                    Token::Empty => {
+                        continue;
+                    }
+                    Token::Done => {
+                        let curr_time = self.time.tick();
+                        self.max_reduce_data
+                            .out_val
+                            .enqueue(&self.time, ChannelElement::new(curr_time + 1, Token::Done))
+                            .unwrap();
+                        return;
+                    }
+                },
+                Err(_) => {
+                    panic!("Unexpected end of stream");
+                }
+            }
+            self.time.incr_cycles(1);
+        }
+    }
+}
+
