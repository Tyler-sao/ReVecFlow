+// 0024: a block that passes through a joiner travels as the joiner's u32 reference type; it must come back unchanged.
+use comal::templates::primitive::Token;
+use comal::templates::tensor::Tensor;
+use ndarray::{Array2, Ix2};
+
+type VT16 = Tensor<'static, f32, Ix2, 16>;
+type VT64 = Tensor<'static, f32, Ix2, 64>;
+
+fn tile16(seed: f32) -> VT16 {
+    Tensor::new(Array2::from_shape_fn((16, 16), |(r, c)| seed + (r * 16 + c) as f32 * 0.5 - 37.25))
+}
+
+#[test]
+fn blocks_survive_the_reference_round_trip() {
+    let a = tile16(1.0);
+    let b = tile16(2.0);
+    let ra: Token<u32, u32> = Token::Val(a.clone()).try_into().unwrap();
+    let rb: Token<u32, u32> = Token::Val(b.clone()).try_into().unwrap();
+    let ra2: Token<u32, u32> = Token::Val(a.clone()).try_into().unwrap();   // a repeated peek of the same element
+    assert_ne!(ra, rb, "two different blocks must get different references");
+    assert_eq!(ra, ra2, "the same block must get the same reference");
+    for (r, t) in [(ra, &a), (rb, &b)] {
+        let back: Token<VT16, u32> = r.into();
+        match back {
+            Token::Val(v) => assert_eq!(v.data, t.data, "block changed through the reference type"),
+            _ => panic!("value token expected"),
+        }
+    }
+    let z: Token<u32, u32> = Token::Val(VT16::default()).try_into().unwrap();
+    let zb: Token<VT16, u32> = z.into();
+    assert!(matches!(zb, Token::Val(ref v) if v.data.iter().all(|x| *x == 0.0)));
+    let s: Token<u32, u32> = Token::<VT16, u32>::Stop(2).try_into().unwrap();
+    assert_eq!(s, Token::Stop(2));
+    let e: Token<VT16, u32> = Token::<u32, u32>::Empty.into();
+    assert!(matches!(e, Token::Empty));
+    let big: VT64 = Tensor::new(Array2::from_shape_fn((64, 64), |(r, c)| (r as f32) - (c as f32) * 1.5));
+    let rbig: Token<u32, u32> = Token::Val(big.clone()).try_into().unwrap();
+    let back: Token<VT64, u32> = rbig.into();
+    assert!(matches!(back, Token::Val(ref v) if v.data == big.data));
+}
+
+#[test]
+#[should_panic(expected = "is not an interned block")]
+fn unknown_reference_panics() {
+    let _ = tile16(5.0);
+    let _: Token<u32, u32> = Token::Val(tile16(7.0)).try_into().unwrap();
+    let _: Token<VT16, u32> = Token::<u32, u32>::Val(4_000_000_000).into();
+}
