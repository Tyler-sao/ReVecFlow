--- a/src/templates/primitive.rs
+++ b/src/templates/primitive.rs
@@ -115,28 +115,92 @@ impl<StopType: DAMType> From<Token<u32, StopType>> for Token<f32, StopType> {
 // (scalar mode passes the f32 bits). Now each distinct block is interned: the u32 is the index of an exact copy of
 // the block (keyed by its values' bits in logical order, so the repeated peeks of one element give one index), and the
 // way out returns that copy. A u32 that is not an interned index panics.
+// 0026: the 0024 table kept every distinct block that ever crossed a joiner for the whole run (one copy as key, one as
+// value): on DBLP's GraphSAGE layer it grew past 58 GB and the run slowed to a crawl. A block's reference is only needed
+// between the joiner's peek of it (conversion in) and its enqueue (conversion out), and DAM converts again on every peek
+// and on the dequeue that follows the enqueue - so a block cannot be freed at its lookup. Now: one copy per block (its
+// value bits, shared by both maps), held in two generations; a hit in the older generation moves the block to the newer
+// one; when the newer one exceeds COMAL_BLOCK_GEN_MB (default 2048 MB) the older one is dropped. Memory stays below about
+// twice that per block size. A reference to a dropped block panics (never a wrong value). Values unchanged from 0024.
+#[derive(Default)]
+struct BlockGen {
+    by_key: std::collections::HashMap<std::sync::Arc<[u32]>, u32>,
+    by_id: std::collections::HashMap<u32, std::sync::Arc<[u32]>>,
+    bytes: usize,
+}
+
+impl BlockGen {
+    fn insert(&mut self, key: std::sync::Arc<[u32]>, id: u32) {
+        self.bytes += key.len() * 4 + 64;
+        self.by_key.insert(key.clone(), id);
+        self.by_id.insert(id, key);
+    }
+    fn remove_id(&mut self, id: u32) -> Option<std::sync::Arc<[u32]>> {
+        let key = self.by_id.remove(&id)?;
+        self.by_key.remove(&key);
+        self.bytes -= key.len() * 4 + 64;
+        Some(key)
+    }
+}
+
 pub struct BlockInterner {
-    ids: std::collections::HashMap<Vec<u32>, u32>,
-    blocks: Vec<ndarray::Array2<f32>>,
+    cur: BlockGen,
+    prev: BlockGen,
+    next_id: u32,
+    limit: usize,
+}
+
+impl BlockInterner {
+    fn new() -> Self {
+        let mb: usize = std::env::var("COMAL_BLOCK_GEN_MB").ok().and_then(|v| v.parse().ok()).unwrap_or(2048);
+        BlockInterner { cur: BlockGen::default(), prev: BlockGen::default(), next_id: 1, limit: mb << 20 }
+    }
+    fn promote(&mut self, id: u32) -> Option<std::sync::Arc<[u32]>> {
+        let key = self.prev.remove_id(id)?;
+        self.cur.insert(key.clone(), id);
+        Some(key)
+    }
+    fn rotate_if_full(&mut self) {
+        if self.cur.bytes > self.limit {
+            self.prev = std::mem::take(&mut self.cur);
+        }
+    }
 }
 
-fn block_intern(reg: &std::sync::Mutex<Option<BlockInterner>>, arr: ndarray::Array2<f32>) -> u32 {
-    let key: Vec<u32> = arr.iter().map(|x| x.to_bits()).collect();
+fn block_intern(reg: &std::sync::Mutex<Option<BlockInterner>>, arr: &ndarray::ArrayView2<f32>) -> u32 {
+    let key: std::sync::Arc<[u32]> = arr.iter().map(|x| x.to_bits()).collect::<Vec<u32>>().into();
     let mut guard = reg.lock().unwrap();
-    let it = guard.get_or_insert_with(|| BlockInterner { ids: std::collections::HashMap::new(), blocks: Vec::new() });
-    if let Some(id) = it.ids.get(&key) {
+    let it = guard.get_or_insert_with(BlockInterner::new);
+    if let Some(id) = it.cur.by_key.get(&key) {
         return *id;
     }
-    let id = u32::try_from(it.blocks.len() + 1).expect("0024: more than u32::MAX distinct blocks through joiners");
-    it.blocks.push(arr);
-    it.ids.insert(key, id);
+    if let Some(id) = it.prev.by_key.get(&key).copied() {
+        it.promote(id);
+        it.rotate_if_full();
+        return id;
+    }
+    let id = it.next_id;
+    it.next_id = it.next_id.checked_add(1).expect("0026: more than u32::MAX block references through joiners");
+    it.cur.insert(key, id);
+    it.rotate_if_full();
     id
 }
 
-fn block_lookup(reg: &std::sync::Mutex<Option<BlockInterner>>, id: u32) -> ndarray::Array2<f32> {
-    // the copy is taken under the lock and the lock released before any panic (a panic under it would poison it)
-    let found = reg.lock().unwrap().as_ref().and_then(|it| it.blocks.get((id as usize).wrapping_sub(1)).cloned());
-    found.unwrap_or_else(|| panic!("0024: block reference {} is not an interned block", id))
+fn block_lookup(reg: &std::sync::Mutex<Option<BlockInterner>>, id: u32, n: usize) -> ndarray::Array2<f32> {
+    // the key is taken under the lock and the lock released before any panic (a panic under it would poison it)
+    let found = {
+        let mut guard = reg.lock().unwrap();
+        guard.as_mut().and_then(|it| match it.cur.by_id.get(&id) {
+            Some(k) => Some(k.clone()),
+            None => {
+                let k = it.promote(id);
+                it.rotate_if_full();
+                k
+            }
+        })
+    };
+    let key = found.unwrap_or_else(|| panic!("0024/0026: block reference {} is not an interned block (never interned, or dropped with an old generation)", id));
+    ndarray::Array2::from_shape_vec((n, n), key.iter().map(|b| f32::from_bits(*b)).collect()).unwrap()
 }
 
