new file mode 100644
index 0000000..b61a9bc
--- /dev/null
+++ b/tests/block_joiner_bounded.rs
@@ -0,0 +1,44 @@
+// 0026: the joiner block table is bounded (two generations of COMAL_BLOCK_GEN_MB); recent blocks round-trip exactly,
+// a block used again moves to the newer generation, a block dropped with an old generation panics (never a wrong value).
+use comal::templates::primitive::Token;
+use comal::templates::tensor::Tensor;
+use ndarray::{Array2, Ix2};
+
+type VT16 = Tensor<'static, f32, Ix2, 16>;
+
+fn tile(seed: usize) -> VT16 {
+    Tensor::new(Array2::from_shape_fn((16, 16), |(r, c)| (seed * 1000 + r * 16 + c) as f32 * 0.25 - 3.0))
+}
+
+fn to_ref(t: &VT16) -> Token<u32, u32> {
+    Token::Val(t.clone()).try_into().unwrap()
+}
+
+fn back(r: Token<u32, u32>) -> Array2<f32> {
+    match Token::<VT16, u32>::from(r) {
+        Token::Val(v) => v.data.to_owned(),
+        _ => panic!("value token expected"),
+    }
+}
+
+#[test]
+fn bounded_table() {
+    std::env::set_var("COMAL_BLOCK_GEN_MB", "1"); // about 960 blocks of 16 x 16 per generation; first use in this binary
+    let keep = tile(0);
+    let r_keep = to_ref(&keep);
+    let first = tile(1);
+    let r_first = to_ref(&first);
+    for i in 2..5000 {
+        let t = tile(i);
+        let r = to_ref(&t);
+        assert_eq!(r, to_ref(&t), "a repeated peek must give the same reference");
+        assert_eq!(back(r), t.data.to_owned(), "a recent block must come back exactly");
+        if i % 300 == 0 {
+            assert_eq!(back(r_keep), keep.data.to_owned(), "a block in use must survive");
+        }
+    }
+    let lost = std::panic::catch_unwind(|| back(r_first));
+    assert!(lost.is_err(), "a block dropped with an old generation must panic, not return a value");
+    let again = tile(4999);
+    assert_eq!(back(to_ref(&again)), again.data.to_owned());
+}
