+/// Fiber writer contents: (tensor, index variable, format, seg, crd)
+type FiberArrays = (String, String, String, Vec<u32>, Vec<u32>);
+/// Value writer contents: (label, values)
+type ValArrays = (String, Vec<f32>);
+
+/// Like run_graph (scalar mode), and also returns what every writer stored, read after the
+/// simulation has finished: (passed, cycles, fibers, vals), each list in the order the writers
+/// appear in the proto. Comal does not know dense shapes; the caller supplies them.
+#[pyfunction]
+fn run_graph_outputs(
+    proto: String,
+    data: String,
+) -> PyResult<(bool, u64, Vec<FiberArrays>, Vec<ValArrays>)> {
+    let comal_graph = {
+        let file_contents = fs::read(proto).unwrap();
+        ComalGraph::decode(file_contents.as_slice()).unwrap()
+    };
+    let (program_builder, outputs) =
+        parse_proto_with_outputs(comal_graph, data.into(), Default::default());
+    let initialized = program_builder.initialize(Default::default()).unwrap();
+    let executed = initialized.run(Default::default());
+    let cycles = executed.elapsed_cycles().unwrap();
+    let passed = executed.passed();
+    println!("Elapsed Cycles: {}", cycles);
+    let fibers = outputs
+        .fibers
+        .into_iter()
+        .map(|f| {
+            let seg = f.seg.lock().unwrap().clone();
+            let crd = f.crd.lock().unwrap().clone();
+            (f.tensor, f.index, f.format, seg, crd)
+        })
+        .collect();
+    let vals = outputs
+        .vals
+        .into_iter()
+        .map(|v| {
+            let values = v.vals.lock().unwrap().clone();
+            (v.label, values)
+        })
+        .collect();
+    Ok((passed, cycles, fibers, vals))
+}
