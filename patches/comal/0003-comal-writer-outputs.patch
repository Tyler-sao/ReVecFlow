+/// parse_proto, also returning shared references to every writer's arrays.
+pub fn parse_proto_with_outputs<'a>(
+    comal_graph: ComalGraph,
+    base_path: PathBuf,
+    sam_options: SamOptions,
+) -> (ProgramBuilder<'a>, WriterOutputs) {
+    let mut builder = ProgramBuilder::default();
+    let mut outputs = WriterOutputs::default();
+    build_from_proto_impl(
+        comal_graph,
+        base_path,
+        sam_options,
+        &mut builder,
+        &mut Default::default(),
+        &mut Default::default(),
+        &mut Default::default(),
+        &mut Default::default(),
+        Some(&mut outputs),
+    );
+    (builder, outputs)
+}
