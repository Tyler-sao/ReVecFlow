+/// 0021: converts a true-block run's writer arrays to the run_graph_outputs format.
+fn block_outputs<V>(
+    passed: bool,
+    cycles: u64,
+    outputs: BlockWriterOutputs<V>,
+    flatten: impl Fn(&V) -> Vec<f32>,
+) -> (bool, u64, Vec<FiberArrays>, Vec<ValArrays>) {
+    let fibers = outputs
+        .fibers
+        .into_iter()
+        .map(|f| {
+            let seg = f.seg.lock().unwrap().clone();
+            let crd = f.crd.lock().unwrap().clone();
+            (f.tensor, f.index, f.format, seg, crd)
+        })
+        .collect();
+    let vals = outputs
+        .vals
+        .into_iter()
+        .map(|v| {
+            let values: Vec<f32> = v.vals.lock().unwrap().iter().flat_map(|b| flatten(b)).collect();
+            (v.label, values)
+        })
+        .collect();
+    (passed, cycles, fibers, vals)
+}
+
+/// 0021: like run_graph_true_block16, and also returns what every writer stored: (passed, cycles,
+/// fibers, vals) as run_graph_outputs, with each stored block flattened row-major (16 x 16 values).
+#[pyfunction]
+fn run_graph_true_block16_outputs(
+    proto: String,
+    data: String,
+) -> PyResult<(bool, u64, Vec<FiberArrays>, Vec<ValArrays>)> {
+    let comal_graph = {
+        let file_contents = fs::read(proto).unwrap();
+        ComalGraph::decode(file_contents.as_slice()).unwrap()
+    };
+    let (program_builder, outputs) =
+        parse_proto_true_block16_with_outputs(comal_graph, data.into(), Default::default());
+    let initialized = program_builder.initialize(Default::default()).unwrap();
+    let executed = initialized.run(Default::default());
+    let cycles = executed.elapsed_cycles().unwrap();
+    let passed = executed.passed();
+    println!("Elapsed Cycles (true_block16): {}", cycles);
+    Ok(block_outputs(passed, cycles, outputs, |t| t.data.iter().cloned().collect()))
+}
+
