+// 0027: vector mode (1-D values of N lanes): the joiner conversions of 0024/0026 (same interner, own table), and the
+// lane sum of a reduction whose result is broadcast over the lanes (the 1-D counterpart of the block row sum).
+macro_rules! vector_token_conversions {
+    ($n:literal, $reg:ident) => {
+        static $reg: std::sync::Mutex<Option<BlockInterner>> = std::sync::Mutex::new(None);
+
+        impl<StopType: DAMType> TryInto<Token<u32, StopType>> for Token<Tensor<'static, f32, ndarray::Ix1, $n>, StopType> {
+            type Error = u32;
+
+            fn try_into(self) -> Result<Token<u32, StopType>, Self::Error> {
+                match self {
+                    Token::Val(val) => Ok(Token::Val(intern_key(&$reg, val.data.iter().map(|x| x.to_bits()).collect::<Vec<u32>>().into()))),
+                    Token::Stop(stop) => Ok(Token::Stop(stop)),
+                    Token::Empty => Ok(Token::Empty),
+                    Token::Done => Ok(Token::Done),
+                }
+            }
+        }
+
+        impl<StopType: DAMType> From<Token<u32, StopType>> for Token<Tensor<'static, f32, ndarray::Ix1, $n>, StopType> {
+            fn from(value: Token<u32, StopType>) -> Self {
+                match value {
+                    Token::Val(id) => Token::Val(Tensor::new_vec(ndarray::Array1::from_vec(
+                        key_lookup(&$reg, id).iter().map(|b| f32::from_bits(*b)).collect()))),
+                    Token::Stop(stop) => Token::Stop(stop),
+                    Token::Empty => Token::Empty,
+                    Token::Done => Token::Done,
+                }
+            }
+        }
+    };
