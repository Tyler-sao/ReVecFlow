+// 0027: max reduction in vector mode: element-wise max over the vectors of a fiber (from -inf), then the max over the
+// lanes broadcast to every lane at the fiber's stop (the row max when the lanes are a row's columns). Timing as MaxReduce.
+#[context_macro]
+pub struct VecMaxReduce<StopType: Clone, const N: usize> {
+    max_reduce_data: MaxReduceData<super::tensor::Tensor<'static, f32, ndarray::Ix1, N>, StopType>,
+}
+
+impl<StopType: DAMType, const N: usize> VecMaxReduce<StopType, N>
+where
+    VecMaxReduce<StopType, N>: Context,
+{
+    pub fn new(max_reduce_data: MaxReduceData<super::tensor::Tensor<'static, f32, ndarray::Ix1, N>, StopType>) -> Self {
+        let red = VecMaxReduce { max_reduce_data, context_info: Default::default() };
+        (red.max_reduce_data.in_val).attach_receiver(&red);
+        (red.max_reduce_data.out_val).attach_sender(&red);
+        red
+    }
+}
+
+impl<StopType, const N: usize> Context for VecMaxReduce<StopType, N>
+where
+    super::tensor::Tensor<'static, f32, ndarray::Ix1, N>: DAMType,
+    StopType: DAMType + std::ops::Sub<u32, Output = StopType> + std::cmp::PartialEq,
+{
+    fn init(&mut self) {}
+
+    fn run(&mut self) {
+        let neg = || ndarray::Array1::<f32>::from_elem(N, f32::NEG_INFINITY);
+        let mut acc = neg();
+        loop {
+            match self.max_reduce_data.in_val.dequeue(&self.time) {
+                Ok(curr_in) => match curr_in.data {
+                    Token::Val(val) => {
+                        acc.zip_mut_with(&val.data, |a, b| {
+                            if *b > *a {
+                                *a = *b
+                            }
+                        });
+                    }
+                    Token::Stop(stkn) => {
+                        let curr_time = self.time.tick();
+                        let m = acc.fold(f32::NEG_INFINITY, |m, x| m.max(*x));
+                        self.max_reduce_data
+                            .out_val
+                            .enqueue(&self.time, ChannelElement::new(curr_time + 1,
+                                Token::Val(super::tensor::Tensor::new_vec(ndarray::Array1::from_elem(N, m)))))
+                            .unwrap();
+                        acc = neg();
+                        if stkn != StopType::default() {
+                            self.max_reduce_data
+                                .out_val
+                                .enqueue(&self.time, ChannelElement::new(curr_time + 1, Token::Stop(stkn - 1)))
+                                .unwrap();
+                        }
+                    }
+                    Token::Empty => {
+                        continue;
+                    }
+                    Token::Done => {
+                        let curr_time = self.time.tick();
+                        self.max_reduce_data
+                            .out_val
+                            .enqueue(&self.time, ChannelElement::new(curr_time + 1, Token::Done))
+                            .unwrap();
+                        return;
+                    }
+                },
+                Err(_) => {
+                    panic!("Unexpected end of stream");
+                }
+            }
+            self.time.incr_cycles(1);
+        }
+    }
+}
