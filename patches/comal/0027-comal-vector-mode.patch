+// 0027: vector mode values (1-D, 16 lanes): element-wise arithmetic, lane sum / lane max reductions, joiner round trip.
+use comal::templates::accumulator::{MaxReduceData, VecMaxReduce};
+use comal::templates::primitive::{FinalReduce, Token};
+use comal::templates::tensor::Tensor;
+use dam::simulation::*;
+use dam::utility_contexts::{CheckerContext, GeneratorContext};
+use ndarray::{Array1, Ix1};
+
+type VV16 = Tensor<'static, f32, Ix1, 16>;
+
+fn v(f: impl Fn(usize) -> f32) -> VV16 {
+    Tensor::new_vec(Array1::from_shape_fn(16, f))
+}
+
+#[test]
+fn elementwise_and_lane_sum() {
+    let a = v(|i| i as f32 + 1.0);
+    let b = v(|i| 2.0 - i as f32 * 0.5);
+    let p = a.clone() * b.clone();
+    for i in 0..16 {
+        assert_eq!(p.data[i], (i as f32 + 1.0) * (2.0 - i as f32 * 0.5));
+    }
+    let mut acc = VV16::default();
+    acc += a.clone();
+    acc += b.clone();
+    assert_eq!(acc.data[3], a.data[3] + b.data[3]);
+    let s = <Token<VV16, u32> as FinalReduce<u32, 4>>::sum_axis(Token::Val(a.clone()));
+    match s {
+        Token::Val(t) => assert!(t.data.iter().all(|x| *x == (1..=16).sum::<i32>() as f32)),
+        _ => panic!("value expected"),
+    }
+}
+
+#[test]
+fn joiner_round_trip() {
+    let a = v(|i| i as f32 * 1.25 - 3.0);
+    let r: Token<u32, u32> = Token::Val(a.clone()).try_into().unwrap();
+    let r2: Token<u32, u32> = Token::Val(a.clone()).try_into().unwrap();
+    assert_eq!(r, r2);
+    match Token::<VV16, u32>::from(r) {
+        Token::Val(t) => assert_eq!(t.data, a.data),
+        _ => panic!("value expected"),
+    }
+}
+
+#[test]
+fn lane_max_over_vectors() {
+    let a = v(|i| i as f32 - 20.0);            // all negative
+    let b = v(|i| if i == 5 { 7.5 } else { -100.0 });
+    let c = v(|i| -(i as f32) - 1.0);           // all negative, alone in the second fiber
+    let expect = vec![
+        Token::<VV16, u32>::Val(v(|_| 7.5)),
+        Token::Val(v(|_| -1.0)),
+        Token::Stop(0),
+        Token::Done,
+    ];
+    let mut ctx = ProgramBuilder::default();
+    let (snd, rcv) = ctx.unbounded::<Token<VV16, u32>>();
+    let (osnd, orcv) = ctx.unbounded::<Token<VV16, u32>>();
+    ctx.add_child(GeneratorContext::new(
+        move || vec![Token::Val(a.clone()), Token::Val(b.clone()), Token::Stop(0), Token::Val(c.clone()), Token::Stop(1), Token::Done].into_iter(),
+        snd,
+    ));
+    ctx.add_child(VecMaxReduce::<u32, 16>::new(MaxReduceData { in_val: rcv, out_val: osnd }));
+    ctx.add_child(CheckerContext::new(move || expect.clone().into_iter(), orcv));
+    ctx.initialize(Default::default()).unwrap().run(Default::default());
+}
