+/// 0027: vector mode, 16 lanes: (passed, cycles, fibers, vals) as run_graph_outputs, every stored vector flattened (16 values).
+#[pyfunction]
+fn run_graph_vector16_outputs(
+    proto: String,
+    data: String,
+) -> PyResult<(bool, u64, Vec<FiberArrays>, Vec<ValArrays>)> {
+    let comal_graph = {
+        let file_contents = fs::read(proto).unwrap();
+        ComalGraph::decode(file_contents.as_slice()).unwrap()
+    };
+    let (program_builder, outputs) =
+        parse_proto_vector16_with_outputs(comal_graph, data.into(), Default::default());
+    let initialized = program_builder.initialize(Default::default()).unwrap();
+    let executed = initialized.run(Default::default());
+    let cycles = executed.elapsed_cycles().unwrap();
+    let passed = executed.passed();
+    println!("Elapsed Cycles (vector16): {}", cycles);
+    Ok(block_outputs(passed, cycles, outputs, |t| t.data.iter().cloned().collect()))
+}
+
 /// 0021: like run_graph_true_block32, and also returns what every writer stored: (passed, cycles,
 /// fibers, vals) as run_graph_outputs, with each stored block flattened row-major (32 x 32 values).
 #[pyfunction]
@@ -288,6 +308,7 @@ fn comal(py: Python, m: &PyModule) -> PyResult<()> {
     m.add_function(wrap_pyfunction!(run_graph, m)?)?;
     m.add_function(wrap_pyfunction!(run_graph_outputs, m)?)?;
     m.add_function(wrap_pyfunction!(run_graph_true_block16_outputs, m)?)?;
+    m.add_function(wrap_pyfunction!(run_graph_vector16_outputs, m)?)?;
     m.add_function(wrap_pyfunction!(run_graph_true_block32_outputs, m)?)?;
     m.add_function(wrap_pyfunction!(run_graph_true_block64_outputs, m)?)?;
     m.add_function(wrap_pyfunction!(run_graph_block16, m)?)?;
