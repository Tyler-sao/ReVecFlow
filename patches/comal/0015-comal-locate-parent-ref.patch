+impl<ValType, StopType> IterateLocate<ValType, StopType>
+where
+    ValType: DAMType
+        + std::cmp::PartialEq
+        + std::ops::Mul<Output = ValType>
+        + std::ops::Add<Output = ValType>,
+    StopType: DAMType + std::ops::Add<u32, Output = StopType> + std::cmp::PartialEq,
+    IterateLocate<ValType, StopType>: Context,
+{
+    /// The located reference is parent reference * extent + coordinate, which is what
+    /// UncompressedCrdRdScan gives for the same level. One parent token is consumed per located
+    /// fiber, the way that scanner consumes its input: a fiber closed by Stop(s) with s > 0 also
+    /// consumes the parent's Stop(s - 1); a parent Stop(t) between fibers is the child's Stop(t + 1).
+    /// Any other pairing of the two streams is a malformed graph and panics.
+    fn run_with_parent(&mut self) {
+        let (parent, extent) = self.parent.take().unwrap();
+        let mut current: Option<ValType> = None;
+        // a fiber closed by Stop(s), s > 0, also closes the parent's fiber with Stop(s - 1)
+        macro_rules! close {
+            ($s:expr) => {
+                if $s != StopType::default() {
+                    match parent.dequeue(&self.time).unwrap().data {
+                        Token::Stop(t) if t.clone() + 1 == $s => {}
+                        other => panic!("locate: fiber closed by stop {:?}, parent gave {:?}", $s, other),
+                    }
+                }
+            };
+        }
+        loop {
+            let in_ref = self.in_ref.dequeue(&self.time).unwrap().data;
+            let in_crd = self.in_crd.dequeue(&self.time).unwrap().data;
+            let ref1 = match in_crd.clone() {
+                Token::Val(c) => {
+                    if current.is_none() {
+                        match parent.dequeue(&self.time).unwrap().data {
+                            Token::Val(p) => current = Some(p),
+                            other => panic!("locate: coordinate {:?}, parent gave {:?}", c, other),
+                        }
+                    }
+                    Token::Val(current.clone().unwrap() * extent.clone() + c)
+                }
+                Token::Stop(s) => {
+                    if current.is_none() {
+                        // a fiber without coordinates, or a stop between fibers
+                        match parent.dequeue(&self.time).unwrap().data {
+                            Token::Val(_) => close!(s.clone()),
+                            Token::Stop(t) if t.clone() + 1 == s => {}
+                            other => panic!("locate: stop {:?} between fibers, parent gave {:?}", s, other),
+                        }
+                    } else {
+                        close!(s.clone());
+                    }
+                    current = None;
+                    Token::Stop(s)
+                }
+                Token::Empty | Token::Done => {
+                    if current.is_some() {
+                        panic!("locate: {:?} inside a located fiber", in_crd);
+                    }
+                    let p = parent.dequeue(&self.time).unwrap().data;
+                    if p != in_crd {
+                        panic!("locate: coordinate stream gave {:?}, parent gave {:?}", in_crd, p);
+                    }
+                    in_crd.clone()
+                }
+            };
+            self.out_ref1
+                .enqueue(&self.time, ChannelElement::new(self.time.tick() + 1, ref1))
+                .unwrap();
+            self.out_ref2
+                .enqueue(&self.time, ChannelElement::new(self.time.tick() + 1, in_ref.clone()))
+                .unwrap();
+            self.out_crd
+                .enqueue(&self.time, ChannelElement::new(self.time.tick() + 1, in_crd.clone()))
+                .unwrap();
+            if in_ref == Token::Done {
+                return;
+            }
+            self.time.incr_cycles(1);
+        }
+    }
+}
