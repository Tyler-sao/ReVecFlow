diff --git a/lib/Dialect/SAM/SamOps.td b/lib/Dialect/SAM/SamOps.td
index 3f04fc0..b37dedc 100644
--- a/lib/Dialect/SAM/SamOps.td
+++ b/lib/Dialect/SAM/SamOps.td
@@ -37,7 +37,10 @@ def SamFiberLookup : SamOp<"fiber_lookup", [ Pure ]>
 
 def SamLocate : SamOp<"locate", [ Pure ]>
 {
-    let arguments = (ins AnyRankedTensor : $input_crd, AnyRankedTensor : $input_ref);
+    // parent_ref: the references of the level above the located one, present when the located level
+    // is not the tensor's first (output_ref1 is then parent * extent + crd)
+    let arguments = (ins AnyRankedTensor : $input_crd, AnyRankedTensor : $input_ref,
+                         Optional<AnyRankedTensor> : $parent_ref);
     let results = (outs AnyRankedTensor : $output_ref1, AnyRankedTensor : $output_ref2, AnyRankedTensor : $output_crd);
     // let assemblyFormat = "$input_crd `:` type($input_crd) `,` $input_ref `:` type($input_ref) attr-dict `->`
     // type($output_ref1) `,` type($output_ref2) `,` type($output_crd)";
diff --git a/lib/Target/ProtoEmitter/ProtoEmitter.cpp b/lib/Target/ProtoEmitter/ProtoEmitter.cpp
index cb80301..cfc82e6 100644
--- a/lib/Target/ProtoEmitter/ProtoEmitter.cpp
+++ b/lib/Target/ProtoEmitter/ProtoEmitter.cpp
@@ -753,6 +753,19 @@ namespace mlir::sam
         new_op->mutable_locate()->mutable_output_crd()->mutable_id()->set_id(
             channel_tracker.get_create_channel(output_crd));
 
+        // Located level below the tensor's first: the parent references, and the tensor/mode whose
+        // shape file gives the level's extent (named as for fiberlookup)
+        if (auto parent_ref = locateOp.getParentRef())
+        {
+            const SamStreamEncodingAttr enc = getSamStreamEncoding(output_ref1.getType());
+            std::string tensor = enc.getTensor().str();
+            new_op->mutable_locate()->set_tensor(tensor.substr(0, tensor.find('_')));
+            new_op->mutable_locate()->set_mode(enc.getMode().getInt());
+            new_op->mutable_locate()->mutable_parent_ref()->mutable_id()->set_id(
+                channel_tracker.get_create_channel(parent_ref));
+            map_channel[parent_ref].emplace_back(new_op->mutable_locate()->mutable_parent_ref());
+        }
+
         return success();
     };
 
